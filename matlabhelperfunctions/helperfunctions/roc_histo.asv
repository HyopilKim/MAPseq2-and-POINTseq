function ROChist=roc_hist(ratio,sourceidx,binwidth)

edges = 0:binWidth:1;
[~,~,idx]=histcounts(ratio,edges);

for i=1:length(edges)
    ratio(idx==i,:)=r;
    r


ratio_only=ratio(:,1);
idx=ratio(:,2);
trueposi=zeros(length(1:(1/binwidth)),1);
x=zeros(length(1:(1/binwidth)),1);

for i=1:(1/binwidth)
    r=binwidth*i;
    true=sum(idx(ratio_only<=r)==sourceidx)/sum(ratio_only<=r);
    trueposi(i)=true;
    x(i)=r;
end

roc_plot=[x,trueposi];
figure;scatter(roc_plot(:,1),roc_plot(:,2));findfigs;xlabel("Ratio thresh"),ylabel("True source");
